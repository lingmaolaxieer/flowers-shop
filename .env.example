# ===== 基础设施（docker-compose 使用）=====
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=flower_ws
MYSQL_PORT=3306
REDIS_PORT=6379

# ===== 后端服务（apps/api 使用，复制为 apps/api/.env）=====
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ===== 本地免 Docker 演示模式（可选）=====
# 设为 sqlite 时用 better-sqlite3 自动建表，无需 MySQL/Redis；
# 生产请删除这两行或改为 DB_TYPE=mysql，并执行 migration。
# 注意：sqlite 模式启动必须预加载 dotenv：npx ts-node -r dotenv/config src/main.ts
# DB_TYPE=sqlite
# SQLITE_PATH=demo.sqlite

MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=rootpass123
MYSQL_DB=flower_ws

REDIS_HOST=127.0.0.1

# JWT（生产环境务必替换为强随机串，且不要提交到仓库）
JWT_SECRET=please-change-this-secret-in-production
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# 微信小程序（需人工提供；未提供时自动走 Mock 登录）
WX_APPID=
WX_APPSECRET=
WX_MOCK_LOGIN=true

# 对象存储（当前留空走本地存储；需人工提供 COS/OSS 密钥）
STORAGE_TYPE=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_SECRET_ID=
STORAGE_SECRET_KEY=

# ===== M4 二维码防伪签名密钥（生产务必替换为强随机串）=====
QR_SIGN_SECRET=please-change-this-qr-secret

# ===== M5 微信支付 v3（需人工提供；留空走 Mock 支付/分账）=====
WX_MCH_ID=
WX_API_V3_KEY=
WX_CERT_SERIAL_NO=
WX_PRIVATE_KEY_PATH=
WECHAT_PAY_MOCK=true
# 微信分账接收方（需人工配置）
WX_PROFIT_SHARE_RECEIVER=

# ===== M6 订阅消息模板 ID（需人工在小程序后台配置）=====
SUBSCRIBE_TEMPLATE_ORDER_STATUS=
SUBSCRIBE_TEMPLATE_TIMEOUT=

# ===== 业务可配参数 =====
# 店家确认订单超时时长（分钟），顾客订单待确认超时自动取消
ORDER_CONFIRM_TIMEOUT_MINUTES=30
# 微信分账冻结期天数（仅提示用，实际以微信为准）
PROFIT_SHARE_FREEZE_DAYS=15

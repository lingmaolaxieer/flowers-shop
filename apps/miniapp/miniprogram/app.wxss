page {
  background: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #1f2329;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #e8543f;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.muted {
  color: #8a9099;
  font-size: 26rpx;
}

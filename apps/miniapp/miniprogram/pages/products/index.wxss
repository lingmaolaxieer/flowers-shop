.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.cart-entry {
  font-size: 28rpx;
  color: #e8543f;
}

.tip {
  padding: 60rpx 0;
  text-align: center;
}

.product {
  display: flex;
  align-items: flex-start;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.meta {
  font-size: 24rpx;
  color: #8a9099;
  line-height: 1.6;
}

.price {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #e8543f;
  font-weight: 600;
}

.tip {
  padding: 60rpx 0;
  text-align: center;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
}

.status {
  font-size: 24rpx;
  color: #e8543f;
}

.amount {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.confirm-btn {
  margin-top: 20rpx;
  background: #fff;
  border: 2rpx solid #e8543f;
  color: #e8543f;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
}

<view class="container">
  <view class="card">
    <view class="title">配送中订单</view>
    <view class="muted section-tip">从 /admin/orders 中筛选 delivering 状态。</view>
  </view>

  <view wx:if="{{loading && orders.length === 0}}" class="muted tip">加载中...</view>
  <view wx:elif="{{orders.length === 0}}" class="muted tip">暂无配送中订单</view>

  <view
    wx:for="{{orders}}"
    wx:key="id"
    class="card order {{selectedId === item.id ? 'selected' : ''}}"
    data-id="{{item.id}}"
    bindtap="onSelect"
  >
    <view class="order-head">
      <view class="order-id">{{item.id}}</view>
      <view class="status">{{item.statusName}}</view>
    </view>
    <view class="muted">{{item.shopName || '花店'}} · {{item.createdAt || ''}}</view>
    <view class="address">{{item.address || '暂无地址'}}</view>
  </view>

  <view class="card">
    <view class="section-title">更新配送状态</view>
    <view class="muted selected-tip">已选订单：{{selectedId || '未选择'}}</view>
    <input class="input" placeholder="输入 status（如 delivered / completed）" value="{{statusInput}}" bindinput="onStatusInput" />
    <button class="btn-primary update-btn" loading="{{updating}}" bindtap="onUpdate">更新状态</button>
  </view>
</view>

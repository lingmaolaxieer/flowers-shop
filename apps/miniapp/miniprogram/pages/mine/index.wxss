.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 28rpx;
  color: #8a9099;
  padding-bottom: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  font-size: 30rpx;
}

.row:last-child {
  border-bottom: none;
}

<view class="container">
  <view wx:if="{{loading && !name}}" class="muted tip">加载中...</view>

  <block wx:else>
    <view class="card">
      <swiper wx:if="{{media.length > 0}}" class="media" indicator-dots circular>
        <swiper-item wx:for="{{media}}" wx:key="url">
          <image
            wx:if="{{item.type === 'image'}}"
            class="media-item"
            src="{{item.url}}"
            mode="aspectFill"
          />
          <video wx:else class="media-item" src="{{item.url}}" controls />
        </swiper-item>
      </swiper>
      <view wx:else class="media-empty">暂无图片/视频</view>

      <view class="name">{{name}}</view>
      <view class="meta">品种：{{variety || '-'}} · 等级：{{grade || '-'}} · 产地：{{origin || '-'}}</view>
      <view class="meta">规格：{{spec || '-'}}</view>
      <view class="price">¥{{currentPriceText}}<text wx:if="{{currentUnit}}"> / {{currentUnit}}</text></view>
      <view wx:if="{{description}}" class="desc">{{description}}</view>
    </view>

    <view class="card">
      <view class="section-title">选择规格</view>
      <view class="sku-list">
        <view
          wx:for="{{skus}}"
          wx:key="id"
          class="sku {{index === selectedSkuIndex ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="onSelectSku"
        >
          <view>{{item.specText}}</view>
          <view class="sku-price">¥{{item.retailPriceText}} / {{item.unit}}</view>
        </view>
      </view>
      <view wx:if="{{skus.length === 0}}" class="muted">暂无可售规格</view>
    </view>

    <view class="card">
      <view class="section-title">数量</view>
      <view class="qty-row">
        <view class="qty-btn" data-delta="-1" bindtap="changeQty">-</view>
        <input class="qty-input" type="number" value="{{qty}}" bindinput="onQtyInput" />
        <view class="qty-btn" data-delta="1" bindtap="changeQty">+</view>
      </view>
    </view>

    <view class="action-bar">
      <button class="cart-btn" bindtap="goCart">购物车</button>
      <button class="btn-primary buy-btn" bindtap="onAddToCart">加入购物车</button>
    </view>
  </block>
</view>

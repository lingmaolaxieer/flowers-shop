.tip {
  padding: 40rpx 0;
  text-align: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.item:last-child {
  border-bottom: none;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.subtotal {
  font-size: 30rpx;
  color: #e8543f;
  font-weight: 600;
}

.qty-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border: 2rpx solid #e5e6eb;
  border-radius: 8rpx;
}

.qty-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
}

.remove {
  margin-left: 24rpx;
  font-size: 24rpx;
  color: #8a9099;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  margin-bottom: 10rpx;
  color: #4e5969;
}

.input,
.picker {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  min-height: 40rpx;
}

.quote-btn {
  background: #fff;
  border: 2rpx solid #e8543f;
  color: #e8543f;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
}

.fee {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #4e5969;
}

.bottom-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 0 30rpx;
}

.total {
  flex: 1;
  font-size: 30rpx;
  color: #e8543f;
  font-weight: 600;
}

.submit-btn {
  width: 260rpx;
}
